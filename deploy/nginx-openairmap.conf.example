# Exemple Nginx : reverse-proxy vers Next.js (standalone) sur 127.0.0.1:3000
# Remplacer server_name et chemins selon l'instance.
#
# Après cutover : plus de try_files SPA / dist/ — tout passe par Node.

upstream openairmap_next {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name openairmap.atmosud.org;

  # ssl_certificate / ...;
  # ssl_certificate_key / ...;

  # Headers utiles pour Host / proto (metadata, sitemap, domainConfig)
  location / {
    proxy_pass http://openairmap_next;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
  }

  # Assets Next — proxy_pass SANS URI pour conserver l’encodage %5B/%5D
  # (dossiers dynamiques [locale], sinon ChunkLoadError 400 en prod)
  location /_next/static/ {
    proxy_pass http://openairmap_next;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}

# Preprod : même upstream, autre server_name + NOINDEX=true dans l'EnvironmentFile
# server {
#   listen 443 ssl http2;
#   server_name preprod-openairmap.atmosud.org;
#   ...
# }
