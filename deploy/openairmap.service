# OpenAirMap – unité systemd (standalone Next.js)
# Copier vers /etc/systemd/system/openairmap.service puis :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now openairmap

[Unit]
Description=OpenAirMap (Next.js standalone)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/webapps/openairmap
EnvironmentFile=-/webapps/openairmap/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# 0.0.0.0 évite le bug standalone Next (rewrite→307) avec HOSTNAME=127.0.0.1 + next-intl as-needed
Environment=HOSTNAME=0.0.0.0
# Après `next build`, le serveur standalone est dans .next/standalone
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
# Limites raisonnables
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
