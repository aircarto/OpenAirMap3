# À fusionner dans .env.local pour tester l'auth Keycloak + API microspot de dev.
# Ne pas committer de secrets.

NEXT_PUBLIC_USE_MICROSPOT_API=true
# Same-origin via rewrite Next (conserve le Bearer). Cible réelle :
MICROSPOT_PROXY_TARGET=http://172.16.13.183:3032/microspot
NEXT_PUBLIC_MICROSPOT_API_URL=/microspot

NEXT_PUBLIC_KEYCLOAK_ENABLED=true
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.atmosud.org
NEXT_PUBLIC_KEYCLOAK_REALM=master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=openairmap

# Origine déclarée dans Keycloak (Valid redirect URIs / Web origins).
# localhost = secure context (crypto.subtle / PKCE OK).
# Doit correspondre EXACTEMENT à :
#   http://localhost:3000/auth/callback
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost:3000
